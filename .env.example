# =====================================================================
# AI Crop Guardian - Environment Configuration
# =====================================================================

# Server Port (Render sets $PORT automatically, default 5000)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# 1. Sign up for free at https://www.mongodb.com/cloud/atlas
# 2. Create an M0 Free Cluster
# 3. Under 'Database Access', create a database user (e.g. username: admin, password: YourPassword123)
# 4. Under 'Network Access', click 'Add IP Address' -> 'Allow Access from Anywhere' (0.0.0.0/0)
# 5. Click 'Connect' -> 'Drivers' -> copy the connection string and paste below:
#    Format: mongodb+srv://<username>:<password>@<cluster-url>/cropguardian?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YourPassword123@cluster0.xxxxx.mongodb.net/cropguardian?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=ai_crop_guardian_secret_super_key_2026

# Weather API (Optional OpenWeatherMap API key)
OPENWEATHER_API_KEY=
