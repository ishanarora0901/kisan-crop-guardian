{
  "name": "ai-crop-guardian",
  "version": "1.0.0",
  "description": "AI Crop Guardian — Intelligent Agriculture Decision-Support & Proactive Risk Intelligence Platform (Full-Stack MERN)",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "server": "cd backend && npm start",
    "client": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "test:system": "cd backend && node utils/verifySystem.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "author": "AI Crop Guardian Team",
  "license": "MIT"
}
